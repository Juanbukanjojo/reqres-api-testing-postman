                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has user data\", () => {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.data).to.be.an(\"array\");\r",
                  "    pm.expect(jsonData.data.length).to.be.greaterThan(0);\r",
                  "})\r",
                  "\r",
                  "const userSchema = {\r",
                  "    type: \"object\",\r",
                  "    properties: {\r",
                  "        name: { type: \"string\" },\r",
                  "        job: { type: \"string\" },\r",
                  "        id: { type: \"string\" },\r",
                  "        createdAt: { type: \"string\" }\r",
                  "    }\r",
                  "}   \r",
                  "\r",
                  "pm.test(\"Response schema is valid\", () => {\r",
                  "     pm.response.to.have.jsonSchema(userSchema);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response time under 500ms\", () => {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(700);\r",
                  "});"
